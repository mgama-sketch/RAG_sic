# Copie este archivo como .env y complete la clave. NUNCA suba .env al repositorio.
OPENROUTER_API_KEY=sk-or-v1-REEMPLACE_CON_SU_CLAVE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modelo principal y modelo alterno del experimento E2 (deben existir en OpenRouter).
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_MODEL_ALTERNO=google/gemini-2.5-flash

# Parámetros comunes a todas las configuraciones.
TEMPERATURA=0.0
MAX_TOKENS_SALIDA=500
